<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice recognition and audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Network for Claude API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep screen on while driving -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PolestarClaude"
        android:usesCleartextTraffic="false">

        <!-- Settings / launcher entry point -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            AssistantActivity is registered as an assistant.
            When the user sets this app as their default digital assistant
            (Settings → Apps → Default apps → Digital assistant),
            pressing the steering wheel voice button in Android Auto
            or long-pressing Home will launch this activity instead of
            Google Assistant.
        -->
        <activity
            android:name=".AssistantActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.PolestarClaude.Assistant">

            <!-- Triggered by long-pressing Home / steering wheel voice button -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Triggered by Android Auto voice command button -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Google Now on Tap / search -->
            <intent-filter>
                <action android:name="com.google.android.googlequicksearchbox.VOICE_SEARCH_RESULTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
