<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PolestarClaude" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/polestar_teal</item>
        <item name="colorPrimaryVariant">@color/polestar_teal_dark</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Full-screen overlay for the assistant — no title bar, semi-transparent nav -->
    <style name="Theme.PolestarClaude.Assistant" parent="Theme.PolestarClaude">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
